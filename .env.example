# Copy to .env and fill in. Never commit .env.
ENV=development   # set to "production" to enforce a strong JWT_SECRET
# Database credentials live in xsc_conf/xsc_conf_pgrs.json (see xsc_conf_pgrs.example.json)
JWT_SECRET=generate-a-random-string-of-32+-chars
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=30
REFRESH_EXPIRY_DAYS=7

# Optional integrations
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=
# Firebase (push notifications): place your service-account JSON at xsc_conf/firebase_credentials.json (gitignored)
